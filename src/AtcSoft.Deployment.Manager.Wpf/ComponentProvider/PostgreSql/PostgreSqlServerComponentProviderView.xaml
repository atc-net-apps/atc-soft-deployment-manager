<UserControl
    x:Class="AtcSoft.Deployment.Manager.Wpf.ComponentProvider.PostgreSql.PostgreSqlServerComponentProviderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:componentProvider="clr-namespace:AtcSoft.Deployment.Manager.Wpf.ComponentProvider"
    xmlns:controls="clr-namespace:AtcSoft.Deployment.Manager.Wpf.ComponentProvider.PostgreSql.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AtcSoft.Deployment.Manager.Wpf.ComponentProvider.PostgreSql"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:PostgreSqlServerComponentProviderViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AtcSoft.Deployment.Manager.Wpf;component/ComponentProvider/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <atcValueConverters:BoolToVisibilityCollapsedValueConverter x:Key="BoolToVisibilityCollapsedValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <atc:BusyOverlay IsBusy="{Binding Path=IsBusy}">
        <atc:GridEx Columns="0,Auto,20,*,10" Rows="Auto">
            <componentProvider:ComponentProviderServiceActionsView
                Grid.Row="0"
                Grid.Column="1"
                Width="200"
                Visibility="{Binding Path=CompactMode, Converter={StaticResource BoolToVisibilityCollapsedValueConverter}}" />
            <atc:UniformSpacingPanel
                Grid.Row="0"
                Grid.Column="3"
                Orientation="Vertical"
                Spacing="10">
                <GroupBox Header="Connection">
                    <Expander IsExpanded="True">
                        <StackPanel Orientation="Vertical">
                            <controls:PostgreSqlConnectionView
                                Margin="0,10,0,0"
                                DataContext="{Binding Path=PostgreSqlConnection}"
                                IsEnabled="False" />
                            <atc:UniformSpacingPanel
                                Margin="10"
                                Orientation="Vertical"
                                Spacing="10">
                                <Button Command="{Binding Path=TestConnectionCommand}" Content="Test Connection" />
                                <atc:LabelTextInfo
                                    LabelText="Test result"
                                    Style="{DynamicResource AtcApps.Styles.LabelTextInfo}"
                                    Text="{Binding Path=TestConnectionResult}" />
                            </atc:UniformSpacingPanel>
                        </StackPanel>
                    </Expander>
                </GroupBox>
            </atc:UniformSpacingPanel>
        </atc:GridEx>
    </atc:BusyOverlay>

</UserControl>